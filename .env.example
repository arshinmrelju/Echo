# Environment configuration for ECHO

# Server Configuration
ECHO_HOST=127.0.0.1
ECHO_PORT=8000
ECHO_DEBUG=false
ECHO_TOKEN=

# Data & Storage
# If unset, defaults to %LOCALAPPDATA%\Echo\data on Windows
ECHO_DATA_DIR=

# Active AI Provider: "mock", "ollama", "openai", "gemini"
ECHO_AI_PROVIDER=mock
ECHO_AI_MODEL=echo-fast-v1
ECHO_AI_API_KEY=
ECHO_AI_API_BASE=
ECHO_AI_TEMPERATURE=0.7
ECHO_AI_MAX_TOKENS=2048

# Security & CORS
ECHO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

